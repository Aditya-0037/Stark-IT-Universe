    "lenis": "1.3.27",
    "motion": "14.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
